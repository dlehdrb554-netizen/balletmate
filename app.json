{
  "expo": {
    "name": "Balletmate",
    "slug": "balletmate",
    "scheme": "balletmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 발레 학원을 찾기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "학원 사진을 등록하기 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ]
    ],
    "android": {
      "package": "com.dlehdrb554.balletmate",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.dlehdrb554.balletmate",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 발레 학원을 찾기 위해 위치 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "학원 사진을 등록하기 위해 사진 보관함 접근 권한이 필요합니다."
      }
    }
  }
}
