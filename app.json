{
  "expo": {
    "name": "Balletmate",
    "slug": "ballet-mate",
    "scheme": "balletmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 발레 학원을 찾기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "발레 커뮤니티 게시글과 학원 가격표·시간표 이미지를 등록하기 위해 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "발레 커뮤니티 게시글에 사진을 촬영해 첨부하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.dlehdrb554.balletmate",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#641B4D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.dlehdrb554.balletmate",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 발레 학원을 찾기 위해 위치 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "발레 커뮤니티 게시글에 사진을 첨부하기 위해 사진 보관함 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "발레 커뮤니티 게시글에 사진을 촬영해 첨부하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "extra": {
      "eas": {
        "projectId": "dc0b7dc4-781f-45a0-837b-4d12d890a5c7"
      }
    }
  }
}
